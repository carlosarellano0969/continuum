# MongoDB Atlas — required for the complete V1 acceptance path
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/
MONGODB_DATABASE=continuum_v1
MONGODB_VECTOR_INDEX=memory_embedding_index

# Model providers: openrouter|ollama|deterministic (chat), voyage|ollama|deterministic (embed)
MODEL_PROVIDER=openrouter
EMBED_PROVIDER=voyage
EMBED_DIMENSIONS=1024

# Hosted embeddings via ai.mongodb.com (Voyage). ENDPOINT is the bare host; the API adds https:// and /v1.
ENDPOINT=ai.mongodb.com
MODEL_API_KEY=<ai.mongodb.com bearer token>

# Hosted chat via OpenRouter
OPENROUTER_API_KEY=<openrouter key>
OPENROUTER_CHAT_MODEL=openai/gpt-oss-20b
OPENROUTER_CHAT_MODEL_FALLBACK=anthropic/claude-haiku-4.5

# Local Ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_CHAT_MODEL=gpt-oss:20b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest
OLLAMA_CONTEXT_WINDOW=4096
OLLAMA_MAX_OUTPUT_TOKENS=512
OLLAMA_REASONING_EFFORT=low
OLLAMA_TIMEOUT_SECONDS=60

# Local application
CONTINUUM_ORG_ID=demo-org
CONTINUUM_AGENT_ID=demo-agent
CONTINUUM_DEMO_SEED=20260924
CONTINUUM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000/api
